# =================================================================
# FlowPilot AI — Environment Configuration Template (.env.example)
# =================================================================

# Database Configuration
# Supports SQLite for local execution or PostgreSQL for production
DATABASE_URL=sqlite:///./data/flowpilot_day3.db

# Email Provider Configuration
# Set to 'sandbox' for deterministic, safe simulated delivery without real email transmission
# Set to 'smtp' for real email delivery via configured SMTP relay
EMAIL_PROVIDER=sandbox
EMAIL_MODE=sandbox

# Real SMTP Configuration (Required when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT=15

# Local AI Runtime Configuration (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Optional Cloud AI Fallback Providers (leave blank to use local Ollama runtime)
OPENROUTER_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# Frontend Backend API Bridge
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000